        "timeout": 90000,
        "chunkTimeout": 90000
      },
      "models": {
        "gpt-5.4": {
          "name": "gpt-5.4"
        }
      }
    }
  },
  "model": "model-port/gpt-5.4",
  "small_model": "model-port/gpt-5.4",
  "plugin": [
    "file:///Users/shanbaotao/Documents/agent%202/.opencode/plugins/medical-skill-receipts.mjs"
  ]
