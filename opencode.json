{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "literature-review",
  "mcp": {
    "literature_review": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:8010/mcp/"
    }
  },
  "permission": {
    "literature_review_finalize_study_design": "ask",
    "literature_review_approve_study_design": "ask",
    "literature_review_confirm_systematic_evidence_phase_start": "ask",
    "literature_review_approve_systematic_evidence": "ask",
    "literature_review_approve_research_writing": "ask"
  },
  "provider": {
    "sensenova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SenseNova",
      "options": {
        "baseURL": "https://token.sensenova.cn/v1",
        "apiKey": "{env:SENSENOVA_API_KEY}",
        "timeout": 90000,
        "chunkTimeout": 90000
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash"
        }
      }
    }
  },
  "model": "sensenova/deepseek-v4-flash",
  "small_model": "sensenova/deepseek-v4-flash",
  "plugin": [
    "file:///Users/shanbaotao/Documents/agent%202/.opencode/plugins/medical-skill-receipts.mjs"
  ]
}
