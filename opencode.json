{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "literature_review": {
      "type": "local",
      "enabled": true,
      "command": ["bash", "scripts/opencode/run-literature-review-mcp.sh"]
    }
  },
  "provider": {
    "model-port": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Model Port",
